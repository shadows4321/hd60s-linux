# Elgato Game Capture HD60 S (0fd9:0076)
# - let the logged-in user access it via libusb
# - start the user's hd60s.service (driver -> v4l2loopback + PipeWire) when plugged in
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="0076", MODE="0660", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="hd60s.service"
